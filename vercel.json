{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/cron.js": { "maxDuration": 60 },
    "api/admin.js": { "maxDuration": 30 },
    "api/wallet.js": { "maxDuration": 20 },
    "api/units.js": { "maxDuration": 20 },
    "api/auth-profile.js": { "maxDuration": 20 }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
